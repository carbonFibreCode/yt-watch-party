{
  "name": "@watchparty/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@socket.io/redis-streams-adapter": "0.3.1",
    "@watchparty/shared": "workspace:*",
    "async-mutex": "0.5.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "lru-cache": "11.5.3",
    "nanoid": "6.0.1",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "rate-limiter-flexible": "11.2.1",
    "redis": "6.3.0",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "4.8.4",
    "tsdown": "0.23.0",
    "tsx": "4.23.15"
  }
