# Copy to .env and adjust. Parsed and validated at boot by apps/server/src/infrastructure/config.ts (LLD SP-20).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public URL the browser uses; also used for the WebSocket origin check.
PUBLIC_ORIGIN=http://localhost:5173

# Postgres (docker compose locally, Neon pooled URL in production)
DATABASE_URL=postgres://watchparty:watchparty@localhost:5433/watchparty

# Optional. When set: Redis room store, Redis rate limiter, Socket.IO Redis Streams adapter.
# When unset: in-memory strategies (single instance only).
REDIS_URL=redis://localhost:6380

# better-auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Optional: defaults to PUBLIC_ORIGIN.
BETTER_AUTH_URL=http://localhost:5173

# Optional. Enables GET /metrics with `Authorization: Bearer <token>`.
METRICS_TOKEN=
